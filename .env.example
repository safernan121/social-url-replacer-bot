# Copy this file to .env and fill in the values. NEVER commit .env.

# Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID: Developer Portal -> your app -> General Information
DISCORD_CLIENT_ID=

# Optional: a server ID to register slash commands instantly (for testing).
# Leave empty to register globally (can take up to ~1 hour to appear).
DEV_GUILD_ID=

# Optional: trace | debug | info | warn | error (default: info)
LOG_LEVEL=info

# Optional: where the SQLite database lives (default: ./data/bot.db)
DATABASE_PATH=

# Optional: path to the rules file (default: ./config/rules.json)
RULES_PATH=

# Optional: heartbeat file used by the health check (default: system temp dir)
HEARTBEAT_PATH=
